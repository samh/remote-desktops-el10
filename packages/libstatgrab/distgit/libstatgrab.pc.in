prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libstatgrab
Description: A library that provides a useful interface to system statistics
Version: @VERSION@
Requires.private: log4cplus
Libs: -L${libdir} -lstatgrab
Libs.private: @LINKFLAGS@
Cflags: -I${includedir}
